const express = require('express');

const sqlite3 = require('sqlite3').verbose();

const bodyParser = require('body-parser');



const app = express();
 const port = 3000;


app.use(bodyParser.json());



const db = new sqlite3.Database('./patient_management.db', (err) => {

 if (err) console.error(err.message);

console.log('Connected to the patient management database.');

db.run('CREATE TABLE IF NOT EXISTS patients (

id INTEGER PRIMARY KEY AUTOINCREMENT,

firstName TEXT NOT NULL,

lastName TEXT NOT NULL.

dob TEXT NOT NULL,

gender TEXT,

contact TEXT UNIQUE NOT NULL
)');

});

 app.post('/api/patients', (req, res) => { 
const { firstName, lastName, dob, gender, contact } = req.body;

}

if (!firstName || !lastName || !dob || !contact) { return res.status(400).json({ error: 'Missing required patient information.' });

}

const sql = `INSERT INTO patients (firstName, lastName, dob, gender, contact) VALUES (?, ?, ?, ?, ?)`;

db.run(sql, [firstName, lastName, dob, gender, contact], function(err) { if (err) {

